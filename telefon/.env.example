# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Business number and SIP trunk of the provider (the provider sends calls to this server's
# address on port 5060 and authenticates with user and password).
SIP_NUMBER=+49...
SIP_TRUNK_HOST=sip.example-provider.de
SIP_TRUNK_USER=
SIP_TRUNK_PASSWORD=

# CRM in Supabase: project address and service role key (Project Settings, API keys).
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=

# Access to the local LiveKit server; any name, secret from: openssl rand -hex 32
LIVEKIT_API_KEY=repocity
LIVEKIT_API_SECRET=

# Models on the server's graphics card.
OLLAMA_MODEL=qwen3:8b
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
PIPER_VOICE=de_DE-ramona-low

# Hard maximum length of a call in minutes (1 to 60).
MAX_CALL_MINUTES=15

# Address the speech service listens on. Empty means 127.0.0.1 (only this stack). 0.0.0.0 lets the
# RadarAuditor worker on the same server use it for the Cockpit assistant; then allow only the
# Docker networks through the firewall: sudo ufw allow from 172.16.0.0/12 to any port 8090 proto tcp
SPEECH_HOST=
